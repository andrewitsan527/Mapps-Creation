  accountName String
  accountType String?
  group       String?
  agent       String?
  salesman    String?

  receiverName String?
  cityName     String?
  distance     Decimal?
  manager      String?
  address      String?
  phoneNo      String?
  mobileNo     String?
  faxNo        String?
  emailId      String?
  residentNo   String?
  cityName2    String?
  address2     String?

  gstin            String?
  compositeNo      String?
  ecoSgstin        String?
  registrationDate DateTime?
  panNo            String?
  tanNo            String?
  kstNo            String?
  cstNo            String?
  gujaratState     String?
  tinNo            String?
  policyNo         String?

  creditLimit    Decimal?
