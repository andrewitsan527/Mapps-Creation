generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  OWNER
  SALES
  STORE
  QC
  ACCOUNTS
  DISPATCH
}

enum ProgramStatus {
  DRAFT
  SENT_TO_MILL
  IN_PROCESS
  RETURNED
  CLOSED
  CANCELLED
}

enum DefectType {
  NONE
  MILL
  WEAVER
  DYEING
  MINOR
}

enum LotOrigin {
  PROGRAM
  SALES_RETURN
}

enum GoodsReturnStatus {
  PENDING_QC
  IN_STOCK
  CLOSED
}

/// Mill return / RF — defected goods to be sent back to mill (1-day SLA from QC).
enum MillReturnStatus {
  OPEN
  SENT
  CLOSED
}

enum DefectSeverity {
  LOW
  MEDIUM
  HIGH
}

enum QualityGrade {
  A
  B
  C
  REJECT
}

enum StockMovementType {
  IN
  OUT
  RESERVE
  RELEASE
  ADJUST
  RETURN
}

enum PaymentDirection {
  RECEIPT
  PAYMENT
}

enum PaymentCategory {
  CUSTOMER_RECEIPT
  MILL_PAYMENT
  WEAVER_PAYMENT
  AGENT_COMMISSION
  OTHER
}

enum BillStatus {
  DRAFT
  ISSUED
  CONVERTED
  CANCELLED
}

enum BillType {
  PROVISIONAL
  SALE
}

enum DispatchStatus {
  DRAFT
  DISPATCHED
  CANCELLED
}

enum WhatsAppStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  STUB
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(SALES)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  qualityChecks QualityCheck[] @relation("QcInspector")
  auditLogs     AuditTrail[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model GreyPurchaseOrder {
  id           String   @id @default(cuid())
  poNumber     String   @unique
  orderDate    DateTime @default(now())
  fabricNotes  String?
  quantity     Decimal?
  unit         String   @default("m")
  dyeingRate   Decimal?
  status       String   @default("OPEN")
  whatsappNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bills    GreyPurchaseBill[]
  programs MillProgram[]
  lots     Lot[]
}

model GreyPurchaseBill {
  id        String            @id @default(cuid())
  billNo    String
  orderId   String
  order     GreyPurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  billDate  DateTime          @default(now())
  amount    Decimal           @default(0)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([orderId, billNo])
}

model MillProgram {
  id            String        @id @default(cuid())
  programNo     String        @unique
  greyOrderId   String?
  greyOrder     GreyPurchaseOrder? @relation(fields: [greyOrderId], references: [id])
  width         Decimal?     
  gsm           Decimal?     
  feelFallNotes String?
  extraMods     String?
  remarks       String?
  photoUrl      String?
  status        ProgramStatus @default(DRAFT)
  sentAt        DateTime?
  /// Set only when a user confirms Mill Return Completed (no more inward expected).
  returnCompletedAt DateTime?
  /// Planned − received at confirmation. Null if never explicitly completed.
  shortageQty   Decimal?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lots    Lot[]
  inwards MillInward[]

  @@index([status])
}

/// Partial physical receipt from the mill against a program (before QC / lot).
model MillInward {
  id         String      @id @default(cuid())
  inwardNo   String      @unique
  programId  String
  program    MillProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  inwardDate DateTime    @default(now())
  quantity   Decimal
  unit       String      @default("m")
  remarks    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  lot            Lot?
  qualityChecks  QualityCheck[]
  millReturns    MillReturn[]

  @@index([programId, inwardDate])
}

model Lot {
  id              String         @id @default(cuid())
  lotNumber       String         @unique
  rollNumber      String?
  marka           String?
  programId       String?
  program         MillProgram?   @relation(fields: [programId], references: [id])
  millInwardId    String?        @unique
  millInward      MillInward?    @relation(fields: [millInwardId], references: [id])
  greyOrderId     String?
  greyOrder       GreyPurchaseOrder? @relation(fields: [greyOrderId], references: [id])
  width           Decimal?
  gsm             Decimal?
  /// Total length for the lot (meters). Equals sum of roll lengths when rolls exist.
  quantity        Decimal
  lengthM         Decimal?
  weightKg        Decimal?
  rollCount       Int            @default(1)
  unit            String         @default("m")
  qualityGrade    QualityGrade   @default(A)
  defectType      DefectType     @default(NONE)
  origin          LotOrigin      @default(PROGRAM)
  /// Priority for return-goods lots (also mirrored on SalesReturn).
  returnPriority  DefectSeverity?
  sourceSaleBillId String?
  sourceSaleBill  SaleBill?      @relation("ReturnSourceBill", fields: [sourceSaleBillId], references: [id])
  parentLotId     String?
  parentLot       Lot?           @relation("LotRelot", fields: [parentLotId], references: [id])
  childLots       Lot[]          @relation("LotRelot")
  onHand          Decimal        @default(0)
  reserved        Decimal        @default(0)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  rolls           LotRoll[]
  qualityChecks   QualityCheck[]
  movements       StockMovement[]
  billLines       SaleBillLine[]
  dispatchLines   DispatchLine[]
  salesReturnsAsOriginal SalesReturn[] @relation("ReturnOriginalLot")
  salesReturnAsNew       SalesReturn?  @relation("ReturnNewLot")
  millReturns            MillReturn[]

  @@index([marka])
  @@index([programId])
  @@index([origin, qualityGrade])
  @@index([sourceSaleBillId])
}

/// Individual rolls inside a lot (each with its own length / weight).
model LotRoll {
  id        String   @id @default(cuid())
  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  rollNo    String
  lengthM   Decimal
  weightKg  Decimal?
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([lotId, rollNo])
  @@index([lotId])
}

model QualityCheck {
  id          String          @id @default(cuid())
  lotId       String?
  lot         Lot?            @relation(fields: [lotId], references: [id], onDelete: SetNull)
  millInwardId String?
  millInward   MillInward?    @relation(fields: [millInwardId], references: [id], onDelete: SetNull)
  inspectorId String?
  inspector   User?           @relation("QcInspector", fields: [inspectorId], references: [id])
  checkedAt   DateTime        @default(now())
  passed      Boolean
  defectType  DefectType      @default(NONE)
  severity    DefectSeverity?
  grade       QualityGrade    @default(A)
  remarks     String?
  photoUrl    String?
  whatsappSent Boolean        @default(false)
  /// GR / QC checklist ticks
  checklistWeaver Boolean     @default(false)
  checklistMill   Boolean     @default(false)
  checklistDying  Boolean     @default(false)
  checklistMinor  Boolean     @default(false)
  millReturns MillReturn[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([defectType, severity])
  @@index([checkedAt])
  @@index([millInwardId])
}

model StockMovement {
  id          String            @id @default(cuid())
  lotId       String
  lot         Lot               @relation(fields: [lotId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Decimal          
  referenceType String?
  referenceId   String?
  notes       String?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([lotId, createdAt])
  @@index([referenceType, referenceId])
}

model SaleBill {
  id              String     @id @default(cuid())
  billNo          String     @unique
  type            BillType
  status          BillStatus @default(DRAFT)
  billDate        DateTime   @default(now())
  /// Credit period is snapshotted from the party when the sale is created.
  paymentTermsDays Int?
  interestRatePct Decimal?
  /// Customer credit starts when goods are actually dispatched.
  creditStartsAt  DateTime?
  dueDate         DateTime?
  preDueReminderSentAt DateTime?
  dueReminderSentAt DateTime?
  subtotal        Decimal    @default(0)
  gstPct          Decimal    @default(0)
  gstAmount       Decimal    @default(0)
  tdsPct          Decimal    @default(0)
  tdsAmount       Decimal    @default(0)
  total           Decimal    @default(0)
  notes           String?
  provisionalId   String?    @unique
  provisional     SaleBill?  @relation("ProvToSale", fields: [provisionalId], references: [id])
  convertedSale   SaleBill?  @relation("ProvToSale")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  lines            SaleBillLine[]
  payments         Payment[]
  dispatches       Dispatch[]
  accountNotes     AccountNote[]
  commissions      CommissionEntry[]
  salesReturns     SalesReturn[]
  returnSourceLots Lot[]           @relation("ReturnSourceBill")

  @@index([type, status])
  @@index([dueDate])
}

model SaleBillLine {
  id          String   @id @default(cuid())
  billId      String
  bill        SaleBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  lotId       String?
  lot         Lot?     @relation(fields: [lotId], references: [id])
  /// Frozen goods identity at billing time (survives later lot edits).
  lotNumber   String?
  fabricName  String?
  quality     String?
  code        String?
  colour      String?
  finishName  String?
  millName    String?
  weaverName  String?
  width       Decimal?
  gsm         Decimal?
  marka       String?
  rollNumber  String?
  rollCount   Int?
  weightKg    Decimal?
  lengthM     Decimal?
  rollsDetail String?
  description String?
  quantity    Decimal
  unit        String   @default("m")
  rate        Decimal  @default(0)
  amount      Decimal  @default(0)

  @@index([billId])
  @@index([lotId])
}

model Dispatch {
  id           String         @id @default(cuid())
  /// Internal delivery ref (UI treats sale bill as the customer document).
  challanNo    String         @unique
  saleBillId   String?
  saleBill     SaleBill?      @relation(fields: [saleBillId], references: [id])
  vehicleNo    String?
  driverName   String?
  driverPhone  String?
  status       DispatchStatus @default(DRAFT)
  dispatchedAt DateTime?
  whatsappSent Boolean        @default(false)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  lines DispatchLine[]

  @@index([saleBillId])
}

model DispatchLine {
  id         String   @id @default(cuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  lotId      String
  lot        Lot      @relation(fields: [lotId], references: [id])
  quantity   Decimal
  /// Snapshot copy for delivery trail
  lotNumber  String?
  fabricName String?
  quality    String?
  code       String?
  colour     String?
  rollsDetail String?

  @@index([dispatchId])
}

model Payment {
  id          String   @id @default(cuid())
  direction   PaymentDirection @default(RECEIPT)
  category    PaymentCategory @default(CUSTOMER_RECEIPT)
  saleBillId  String?
  saleBill    SaleBill? @relation(fields: [saleBillId], references: [id])
  commissionEntryId String?
  commissionEntry CommissionEntry? @relation(fields: [commissionEntryId], references: [id])
  amount      Decimal 
  paidAt      DateTime @default(now())
  method      String?
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([direction, category, paidAt])
  @@index([commissionEntryId])
}

model WhatsAppMessageLog {
  id           String         @id @default(cuid())
  to           String
  template     String
  entityType   String?
  entityId     String?
  payload      Json?
  status       WhatsAppStatus @default(QUEUED)
  providerId   String?
  error        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([entityType, entityId])
  @@index([status, createdAt])
}

model AuditTrail {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

enum NoteType {
  DEBIT
  CREDIT
}

enum CommissionBasis {
  MILL
  WEAVER
  PARTY
}

model AccountNote {
  id          String   @id @default(cuid())
  noteNo      String   @unique
  type        NoteType
  saleBillId  String?
  saleBill    SaleBill? @relation(fields: [saleBillId], references: [id])
  amount      Decimal
  reason      String?
  tdsPct      Decimal  @default(0)
  tdsAmount   Decimal  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([saleBillId])
}

model CommissionEntry {
  id              String          @id @default(cuid())
  basis           CommissionBasis
  saleBillId      String?
  saleBill        SaleBill?       @relation(fields: [saleBillId], references: [id])
  ratePct         Decimal         @default(0)
  amount          Decimal         @default(0)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  payments         Payment[]

  @@index([basis])
}

model SalesReturn {
  id             String            @id @default(cuid())
  /// Document + lot tag prefix MCSR-…
  returnNo       String            @unique
  status         GoodsReturnStatus @default(PENDING_QC)
  priority       DefectSeverity    @default(MEDIUM)
  saleBillId     String?
  saleBill       SaleBill?         @relation(fields: [saleBillId], references: [id])
  saleBillLineId String?
  markaPhotoUrl  String?
  /// Original lot if sticker / tag still known (optional — often lost after months).
  originalLotId  String?
  originalLot    Lot?              @relation("ReturnOriginalLot", fields: [originalLotId], references: [id])
  /// New MCSR inventory lot created at intake; stocked after GR QC.
  newLotId       String?           @unique
  newLot         Lot?              @relation("ReturnNewLot", fields: [newLotId], references: [id])
  quantity       Decimal
  reason         String?
  restock        Boolean           @default(true)
  qualityGrade   QualityGrade?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, priority])
  @@index([saleBillId])
  @@index([originalLotId])
}

/// RF (return-to-mill) raised when QC finds mill / other defects that must go back.
model MillReturn {
  id              String          @id @default(cuid())
  rfNo            String          @unique
  status          MillReturnStatus @default(OPEN)
  lotId           String?
  lot             Lot?            @relation(fields: [lotId], references: [id], onDelete: SetNull)
  millInwardId    String?
  millInward      MillInward?     @relation(fields: [millInwardId], references: [id], onDelete: SetNull)
  qualityCheckId  String?
  qualityCheck    QualityCheck?   @relation(fields: [qualityCheckId], references: [id])
  /// QC kind: PROGRAM (normal inward) or SALES_RETURN (goods return).
  source          LotOrigin       @default(PROGRAM)
  qcAt            DateTime
  /// SLA: must physically send to mill by this time (QC + 1 day).
  dueAt           DateTime
  sentAt          DateTime?
  whatsappSent    Boolean         @default(false)
  goodsSummary    String?
  remarks         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, dueAt])
  @@index([lotId])
  @@index([qualityCheckId])
}

enum CrDr {
  CR
  DR
}

model SalesAgent {
  id               String    @id @default(cuid())
  agentName        String
  contactPerson    String?
  mobileNo         String?
  phoneNo          String?
  emailId          String?
  address          String?
  city             String?
  residentNo       String?
  faxNo            String?
  panNo            String?
  gstin            String?
  compositeNo      String?
  registrationDate DateTime?
  blackListed      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  salesMasters SalesMaster[]
}

model SalesMaster {
  id            String  @id @default(cuid())
  accountName   String
  salesAgentId  String
  salesAgent    SalesAgent @relation(fields: [salesAgentId], references: [id])
  group         String?
  salesman      String?

  receiverName String?
  cityName     String?
  distance     Decimal?
  manager      String?
  address      String?
  phoneNo      String?
  mobileNo     String?
  faxNo        String?
  emailId      String?
  residentNo   String?
  cityName2    String?
  address2     String?

  gstin            String?
  compositeNo      String?
  ecoSgstin        String?
  registrationDate DateTime?
  panNo            String?
  tanNo            String?
  kstNo            String?
  cstNo            String?
  gujaratState     String?
  tinNo            String?
  policyNo         String?

  creditLimit    Decimal?
  creditDays     Int?
  openingBalance Decimal?
  crDr           CrDr?
  tds            Decimal?
  payment        String?
  tcsApplicable  Boolean?
  references     String?

  transName            String?
  discountPercentage   Decimal?
  rdPcs                Decimal?
  mts                  Decimal?
  excessRate           Decimal?
  commissionPercentage Decimal?

  bankDetail String?
  bankName   String?
  accountNo  String?
  ifscCode   String?
  branch     String?

  udyamRegistrationNumber String?
  enterpriseType          String?
  enterpriseActivity      String?

  masterType  String   @default("SALES")
  blackListed Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salesBills SalesBillEntry[]

  @@index([salesAgentId])
}

model Transport {
  id            String   @id @default(cuid())
  transportName String
  phoneNo       String?
  emailId       String?
  transIdGstin  String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salesBills SalesBillEntry[]
}

model Haste {
  id               String    @id @default(cuid())
  hasteName        String
  receiverName     String?
  cityName         String?
  distance         Decimal?
  manager          String?
  address          String?
  phoneNo          String?
  mobileNo         String?
  faxNo            String?
  emailId          String?
  residentNo       String?
  kstNo            String?
  gujaratState     String?
  cstNo            String?
  transport        String?
  tinNo            String?
  policyNo         String?
  panNo            String?
  gstin            String?
  compositeNo      String?
  registrationDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  salesBills SalesBillEntry[]
}

model Item {
  id          String  @id @default(cuid())
  itemName    String
  quality     String?
  itemCategories String?
  itemGroup   String?
  hsnCode     String?
  gstPercentage Decimal?
  descriptionForGst String?

  itemRatePer    String?
  openingPcs     Decimal?
  openingMts     Decimal?
  openingValue   Decimal?
  ratePerPcs     Decimal?
  ratePerMts     Decimal?
  purRatePerPcs  Decimal?
  purRatePerMts  Decimal?

  itemFold String?

  imagePath1 String?
  imagePath2 String?
  imagePath3 String?
  imagePath4 String?
  imagePath5 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  greyBillItems GreyBillItem[]
  millInwardItems MillInwardEntryItem[]
  salesBillLines SalesBillEntryLine[]
  finishedWorkLines FinishedWorkEntryLine[]
}

model PurchaseAgent {
  id               String    @id @default(cuid())
  agentName        String
  accountType      String?
  contactPerson    String?
  mobileNo         String?
  phoneNo          String?
  emailId          String?
  address          String?
  city             String?
  residentNo       String?
  faxNo            String?
  panNo            String?
  gstin            String?
  compositeNo      String?
  registrationDate DateTime?
  masterType       String    @default("PURCHASE_AGENT")
  blackListed      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Job {
