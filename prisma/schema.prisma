}

model Knitter {
  id          String  @id @default(cuid())
  knitterName String
  accountType String?
  group       String?
  agent       String?

  gstin            String?
  compositeNo      String?
  ecoSgstin        String?
  registrationDate DateTime?

  receiverName String?
  address      String?
  cityName     String?
  distance     Decimal?
  phoneNo      String?
  mobileNo     String?
  faxNo        String?
  emailId      String?
  residentNo   String?
  address2     String?
  cityName2    String?
  manager      String?

  creditLimit    Decimal?
  creditDays     Int?
  references     String?
  openingBalance Decimal?
  crDr           CrDr?
  tds            Decimal?

  panNo        String?
  tanNo        String?
  kstNo        String?
  cstNo        String?
  gujaratState String?
  tinNo        String?

  transName       String?
  discPercentage  Decimal?
  rdPcs           Decimal?
  mts             Decimal?
  commPercentage  Decimal?

  bankDetail String?
  bankName   String?
  accountNo  String?
  ifscCode   String?
  branch     String?

  udyamRegNumber     String?
  enterpriseType     String?
  enterpriseActivity String?

  tcsApplicable Boolean?
  payment       String?

  blackListed Boolean  @default(false)
  masterType  String   @default("KNITTER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders    PurchaseOrder[]
  greyBills         GreyBill[]
  millInwardEntries MillInwardEntry[]
}

model Mill {
  id        String  @id @default(cuid())
  millName  String
  accountType String?
  group     String?
  agent     String?

  gstin            String?
  compositeNo      String?
  ecoSgstin        String?
  registrationDate DateTime?

  receiverName String?
  address      String?
  cityName     String?
  distance     Decimal?
  phoneNo      String?
  mobileNo     String?
  faxNo        String?
  emailId      String?
  residentNo   String?
  address2     String?
  cityName2    String?
  manager      String?

  creditLimit    Decimal?
  creditDays     Int?
  references     String?
  openingBalance Decimal?
  crDr           CrDr?
  tds            Decimal?
  tdsAccount     String?
  tdsLimit       Decimal?
  dob            DateTime?

  panNo        String?
  tanNo        String?
  kstNo        String?
  cstNo        String?
  gujaratState String?
  tinNo        String?

  transName      String?
  discPercentage Decimal?
  rdPcs          Decimal?
  mts            Decimal?
  commPercentage Decimal?

  bankDetail String?
  bankName   String?
  accountNo  String?
  ifscCode   String?
  branch     String?

  udyamRegNumber     String?
  enterpriseType     String?
  enterpriseActivity String?

  tcsApplicable Boolean?
  payment       String?

  blackListed Boolean  @default(false)
  masterType  String   @default("MILL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  greyBills          GreyBill[]
  millInwardEntries  MillInwardEntry[]
  millProgramEntries MillProgramEntry[]
  finishedWorkEntries FinishedWorkEntry[]
}

/// New purchase-order desk. Separate from GreyPurchaseOrder, which the older mill-program flow still uses.
model PurchaseOrder {
  id        String  @id @default(cuid())
  srNo      String  @unique
  knitterId String
  knitter   Knitter @relation(fields: [knitterId], references: [id], onDelete: Restrict)
  quality   String
  qtyUnits  Decimal
  rate      Decimal
  agent     String
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  greyBills GreyBill[]

  @@index([knitterId])
}

/// New Grey Bill desk at /grey-purchase. Separate from GreyPurchaseOrder.
model GreyBill {
  id          String    @id @default(cuid())
  srNo        String    @unique
  billDate    DateTime
  billNo      String    @default("")
  challanNo   String    @default("")
  knitterId   String?
  knitter     Knitter?  @relation(fields: [knitterId], references: [id], onDelete: Restrict)
  millId      String?
  mill        Mill?     @relation(fields: [millId], references: [id], onDelete: Restrict)
  agent       String?
  remarks     String?
  freightRate Decimal?
  goodsAmount   Decimal @default(0)
  freightAmount Decimal @default(0)
  taxableAmount Decimal @default(0)
  sgstAmount    Decimal @default(0)
  cgstAmount    Decimal @default(0)
  netAmount     Decimal @default(0)
  status      String    @default("SAVED")
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  matchScore  Int?
  matchStatus String?
  matchedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items GreyBillItem[]
  rolls GreyBillRoll[]
  millInward MillInwardEntry?

  @@index([knitterId])
  @@index([millId])
  @@index([purchaseOrderId])
}

model GreyBillItem {
  id         String   @id @default(cuid())
  greyBillId String
  greyBill   GreyBill @relation(fields: [greyBillId], references: [id], onDelete: Cascade)
  itemId     String?
  item       Item?    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sortOrder  Int
  rolls      Decimal?
  qtyKg      Decimal?
  rate       Decimal?
  amount     Decimal  @default(0)

  @@index([greyBillId])
  @@index([itemId])
}

model GreyBillRoll {
  id         String   @id @default(cuid())
  greyBillId String
  greyBill   GreyBill @relation(fields: [greyBillId], references: [id], onDelete: Cascade)
  sortOrder  Int
  weightKg   Decimal?

  @@index([greyBillId])
}

/// New Mill Inward desk at /mill-inward. Separate from MillInward, which the older program flow still uses.
model MillInwardEntry {
  id          String    @id @default(cuid())
  srNo        String    @unique
  inwardDate  DateTime
  dateOfIssue DateTime?
  knitterId   String?
  knitter     Knitter?  @relation(fields: [knitterId], references: [id], onDelete: Restrict)
  millId      String?
  mill        Mill?     @relation(fields: [millId], references: [id], onDelete: Restrict)
  quantityKg  Decimal?
  remarks     String?
  status      String    @default("pending")
  sentOn      DateTime?
  sourceType  String    @default("MANUAL")
  greyBillId  String?   @unique
  greyBill    GreyBill? @relation(fields: [greyBillId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  qualityCheckId          String?  @unique
  qualityCheck            QualityCheckEntry? @relation(fields: [qualityCheckId], references: [id], onDelete: Restrict)
  sendNote                String   @default("")
  returnItemName          String   @default("")
  returnKnitterChallanNo  String   @default("")
  returnChallanNo         String   @default("")
  returnCode              String   @default("")
  returnColour            String   @default("")
  returnFailedRolls       Int?
  returnGrade             String   @default("")
  returnDefectType        String   @default("")
  returnQcSrNo            String   @default("")
  returnFinishedWorkSrNo  String   @default("")
  returnProgramSrNo       String   @default("")

  items MillInwardEntryItem[]
  rolls MillInwardEntryRoll[]
  returnLines MillInwardEntryReturnLine[]
  millPrograms MillProgramEntry[]

  @@index([knitterId])
  @@index([millId])
}

model MillInwardEntryItem {
  id        String          @id @default(cuid())
  entryId   String
  entry     MillInwardEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  itemId    String?
  item      Item?           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sortOrder Int
  rolls     Decimal?
  qtyKg     Decimal?

  @@index([entryId])
  @@index([itemId])
}

model MillInwardEntryRoll {
  id        String          @id @default(cuid())
  entryId   String
  entry     MillInwardEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sortOrder Int
  weightKg  Decimal?

  @@index([entryId])
}

/// New Mill Program desk at /mill-program. Separate from MillProgram, which the older /programs flow still uses.
model MillProgramEntry {
  id                 String           @id @default(cuid())
  srNo               String           @unique
  programDate        DateTime
  millId             String?
  mill               Mill?            @relation(fields: [millId], references: [id], onDelete: Restrict)
  millInwardEntryId  String?
  millInwardEntry    MillInwardEntry? @relation(fields: [millInwardEntryId], references: [id], onDelete: Restrict)
  typeOfFinish       String           @default("")
  gsm                String           @default("")
  width              String           @default("")
  status             String           @default("saved")
  sentAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  lines MillProgramEntryLine[]
  finishedWorks FinishedWorkEntry[]
  qualityChecks QualityCheckEntry[]

  @@index([millId])
  @@index([millInwardEntryId])
}

/// New Finished Work desk at /finished-work. Linked to the new Mill Program, not the older program flow.
model FinishedWorkEntry {
  id                  String           @id @default(cuid())
  srNo                String           @unique
  workDate            DateTime
  millProgramEntryId  String?
  millProgramEntry    MillProgramEntry? @relation(fields: [millProgramEntryId], references: [id], onDelete: Restrict)
  millId              String?
  mill                Mill?            @relation(fields: [millId], references: [id], onDelete: Restrict)
  gpNo                String           @default("")
  knitterChallanNo    String           @default("")
  challanNo           String           @default("")
  lotNo               String           @default("")
  rolls               Int
  greyKg              Decimal
  finishedKg          Decimal
  rate                Decimal
  shortageKg          Decimal
  shortagePct         Decimal
  amount              Decimal
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  qualityChecks QualityCheckEntry[]
  lines FinishedWorkEntryLine[]

  @@index([millProgramEntryId])
  @@index([millId])
}

model FinishedWorkEntryLine {
  id        String            @id @default(cuid())
  entryId   String
  entry     FinishedWorkEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sortOrder Int
  itemId    String?
  item      Item?             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lotNo     String            @default("")
  rate      Decimal           @default(0)
  rolls     Int               @default(0)
  greyKg    Decimal           @default(0)
  finishedKg Decimal          @default(0)
  amount    Decimal           @default(0)

  rollRows FinishedWorkEntryRoll[]

  @@index([entryId])
  @@index([itemId])
}

model FinishedWorkEntryRoll {
  id         String                 @id @default(cuid())
  lineId     String
  line       FinishedWorkEntryLine  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  sortOrder  Int
  greyKg     Decimal
  finishedKg Decimal

  @@index([lineId])
}

/// New Quality Check desk at /quality-check. Separate from QualityCheck, which the older /qc flow still uses.
model QualityCheckEntry {
  id                 String             @id @default(cuid())
  srNo               String             @unique
  qcDate             DateTime
  finishedWorkId     String
  finishedWork       FinishedWorkEntry  @relation(fields: [finishedWorkId], references: [id], onDelete: Restrict)
  millProgramEntryId String
  millProgramEntry   MillProgramEntry   @relation(fields: [millProgramEntryId], references: [id], onDelete: Restrict)
  knitterChallanNo   String             @default("")
  result             String
  grade              String             @default("")
  defectType         String             @default("")
  remarks            String             @default("")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  lines      QualityCheckEntryLine[]
  millInward MillInwardEntry?
  stockRolls LiveStockRoll[]

  @@index([finishedWorkId])
  @@index([millProgramEntryId])
}

model QualityCheckEntryLine {
  id        String            @id @default(cuid())
  qcId      String
  qc        QualityCheckEntry @relation(fields: [qcId], references: [id], onDelete: Cascade)
  sortOrder Int
  rolls     Int
  codeNo    String            @default("")
  colour    String            @default("")

  @@index([qcId])
}

/// Physical rolls created by a new QC pass. Separate from Lot.
model LiveStockRoll {
  id                  String            @id @default(cuid())
  colour              String
  rollNo              String
  status              String            @default("available")
  createdAt           DateTime          @default(now())
  qualityCheckEntryId String
  qualityCheckEntry   QualityCheckEntry @relation(fields: [qualityCheckEntryId], references: [id], onDelete: Cascade)

  @@unique([qualityCheckEntryId, rollNo])
  @@index([status])
  @@index([qualityCheckEntryId])
}

/// Snapshot of the QC received rows copied onto a QC fail Mill Inward. Not a weight-per-roll table.
model MillInwardEntryReturnLine {
  id        String          @id @default(cuid())
  entryId   String
  entry     MillInwardEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sortOrder Int
  rolls     Int
  codeNo    String          @default("")
  colour    String          @default("")

  @@index([entryId])
}

model MillProgramEntryLine {
  id        String           @id @default(cuid())
  programId String
  program   MillProgramEntry @relation(fields: [programId], references: [id], onDelete: Cascade)
  sortOrder Int
  rolls     Int?
  codeNo    String           @default("")
  colour    String           @default("")

  @@index([programId])
}

/// New Sales desk at /sales. Separate from SaleBill, which the older /sales/[billId] flow still uses.
model SalesBillEntry {
  id                String       @id @default(cuid())
  billNo            String       @unique
  billDate          DateTime
  challanNo         String       @default("")
  salesMasterId     String?
  salesMaster       SalesMaster? @relation(fields: [salesMasterId], references: [id], onDelete: Restrict)
  hasteId           String?
  haste             Haste?       @relation(fields: [hasteId], references: [id], onDelete: Restrict)
  lrNo              String       @default("")
  transportId       String?
  transport         Transport?   @relation(fields: [transportId], references: [id], onDelete: Restrict)
  noOfParcel        String       @default("")
  ewayNumber        String       @default("")
  lrDate            DateTime?
  destination       String       @default("")
  paymentWithinDays String       @default("")
  discount          String       @default("")
  addLessAmount     String       @default("")
  freight           String       @default("")
  cgstPct           Decimal
  sgstPct           Decimal
  cgstAmount        Decimal
  sgstAmount        Decimal
  grossAmount       Decimal
  discountAmount    Decimal
  freightAmount     Decimal
  taxableAmount     Decimal
  netAmount         Decimal
  totalRolls        Decimal
  totalWeightKg     Decimal
  status            String       @default("OPEN")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  lines SalesBillEntryLine[]

  @@index([salesMasterId])
  @@index([hasteId])
  @@index([transportId])
  @@index([billDate])
}

model SalesBillEntryLine {
  id        String         @id @default(cuid())
  billId    String
  bill      SalesBillEntry @relation(fields: [billId], references: [id], onDelete: Cascade)
  sortOrder Int
  itemId    String?
  item      Item?          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  colourCode String        @default("")
  hsn        String        @default("")
  noOfRolls  String        @default("")
  weightKg   Decimal
  rate       String        @default("")
  amount     Decimal

  rolls SalesBillEntryRoll[]

  @@index([billId])
  @@index([itemId])
}

model SalesBillEntryRoll {
  id        String             @id @default(cuid())
  lineId    String
  line      SalesBillEntryLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  sortOrder Int
  weight    String             @default("")

  @@index([lineId])
}
